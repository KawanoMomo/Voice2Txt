<Project>
  <!--
    CUDA の再頒布 DLL(cudart64_13 / cublas64_13 / cublasLt64_13)を exe の横に置く。
    Whisper.net.Runtime.Cuda の ggml-cuda-whisper.dll がこれらを要し(Whisper.net は cudart64_13 で GPU の有無を確かめる)、無いと CPU に落ちる。
    取得はビルド時だけ(製品は実行時にネットへ出ない)。取得元は NVIDIA の公式 redist に固定し、SHA-256 を確かめてから展開する。
    キャッシュ: %LOCALAPPDATA%\Voice2Txt\redist(worktree 間で共用)。FFV_SkipCudaRedist=true で取得しない(その場合は CPU で動く)。
  -->
  <PropertyGroup>
    <FFV_CudaRedistBase>https://developer.download.nvidia.com/compute/cuda/redist</FFV_CudaRedistBase>
    <FFV_CudaRedistCache Condition="'$(FFV_CudaRedistCache)' == ''">$(LOCALAPPDATA)\Voice2Txt\redist</FFV_CudaRedistCache>
  </PropertyGroup>

  <ItemGroup>
    <FFV_CudaArchive Include="cuda_cudart-windows-x86_64-13.0.96-archive">
      <Url>$(FFV_CudaRedistBase)/cuda_cudart/windows-x86_64/cuda_cudart-windows-x86_64-13.0.96-archive.zip</Url>
      <Sha256>a2ed875f9997aa24904fb70cc9db3acd9308433cde99bc8e63ec1271c9da31b4</Sha256>
    </FFV_CudaArchive>
    <FFV_CudaArchive Include="libcublas-windows-x86_64-13.1.0.3-archive">
      <Url>$(FFV_CudaRedistBase)/libcublas/windows-x86_64/libcublas-windows-x86_64-13.1.0.3-archive.zip</Url>
      <Sha256>4ac4847bbe4f7709b244956fcfc32197a2954ee70b155cb67eebd9ee26f7e339</Sha256>
    </FFV_CudaArchive>
    <FFV_CudaDll Include="cuda_cudart-windows-x86_64-13.0.96-archive\bin\x64\cudart64_13.dll" />
    <FFV_CudaDll Include="libcublas-windows-x86_64-13.1.0.3-archive\bin\x64\cublas64_13.dll" />
    <FFV_CudaDll Include="libcublas-windows-x86_64-13.1.0.3-archive\bin\x64\cublasLt64_13.dll" />
  </ItemGroup>

  <Target Name="FFV_FetchCudaRedist" BeforeTargets="AssignTargetPaths" Condition="'$(FFV_SkipCudaRedist)' != 'true'">
    <ItemGroup>
      <!-- 展開済み(.verified あり)のものは何もしない -->
      <FFV_CudaTodo Include="@(FFV_CudaArchive)" Condition="!Exists('$(FFV_CudaRedistCache)\%(Identity)\.verified')">
        <Zip>$(FFV_CudaRedistCache)\%(Identity).zip</Zip>
      </FFV_CudaTodo>
    </ItemGroup>
    <MakeDir Directories="$(FFV_CudaRedistCache)" />
    <DownloadFile Condition="'@(FFV_CudaTodo)' != '' And !Exists('%(FFV_CudaTodo.Zip)')"
                  SourceUrl="%(FFV_CudaTodo.Url)" DestinationFolder="$(FFV_CudaRedistCache)" DestinationFileName="%(FFV_CudaTodo.Identity).zip" Retries="2" />
    <ItemGroup>
      <FFV_CudaZip Include="%(FFV_CudaTodo.Zip)" Condition="'@(FFV_CudaTodo)' != ''">
        <Sha256>%(FFV_CudaTodo.Sha256)</Sha256>
        <Dir>%(FFV_CudaTodo.Identity)</Dir>
      </FFV_CudaZip>
    </ItemGroup>
    <GetFileHash Condition="'@(FFV_CudaZip)' != ''" Files="@(FFV_CudaZip)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="FFV_CudaHashed" />
    </GetFileHash>
    <!-- MSBuild の == は大文字小文字を区別しない -->
    <Delete Condition="'@(FFV_CudaHashed)' != '' And '%(FFV_CudaHashed.FileHash)' != '%(FFV_CudaHashed.Sha256)'" Files="%(FFV_CudaHashed.Identity)" />
    <Error Condition="'@(FFV_CudaHashed)' != '' And '%(FFV_CudaHashed.FileHash)' != '%(FFV_CudaHashed.Sha256)'"
           Text="CUDA の再頒布物のハッシュが一致しない: %(FFV_CudaHashed.Identity)(消したので、もう一度ビルドすると取り直す)" />
    <Unzip Condition="'@(FFV_CudaHashed)' != ''" SourceFiles="@(FFV_CudaHashed)" DestinationFolder="$(FFV_CudaRedistCache)" />
    <Touch Condition="'@(FFV_CudaHashed)' != ''" Files="$(FFV_CudaRedistCache)\%(FFV_CudaHashed.Dir)\.verified" AlwaysCreate="true" />
    <ItemGroup>
      <!-- プロジェクトの外のファイルは Link 無しでもファイル名だけで exe の横に置かれる -->
      <None Include="@(FFV_CudaDll->'$(FFV_CudaRedistCache)\%(Identity)')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
