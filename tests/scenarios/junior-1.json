{
  "name": "junior-1",
  "persona": "junior",
  "step": 1,
  "description": "設定 backend: vulkan で起こす(NVIDIA の GPU が無い PC と同じく Vulkan で動く)。起動直後(モデル読み込み中)にトークキーを押すと「モデル準備中」が出て録音されず、何も届かない(流し終わりまで押し続ける手は待たずに返り、理由を holdSkips に残す)。離した 1 秒後も「モデル準備中」の知らせは出たままで、短く押した人も読める。用意ができたら 1 文を押して流すと、Vulkan で文字起こしした確定版が 1 回だけ届く。動いている版(VERSION のタグ)が result.json とトレイのツールチップの文言に出る",
  "timeoutMs": 600000,
  "settings": { "backend": "vulkan" },
  "actions": [
    { "do": "focus", "window": "textbox" },
    { "do": "press", "audio": "test-results/fixtures/ja-one-sentence.wav" },
    { "do": "holdUntilAudioEnd" },
    { "do": "wait", "ms": 500 },
    { "do": "release" },
    { "do": "wait", "ms": 1000 },
    { "do": "shot", "name": "離した後" },
    { "do": "waitModel", "timeoutMs": 540000 },
    { "do": "waitIdle", "timeoutMs": 60000 },
    { "do": "press", "audio": "test-results/fixtures/ja-one-sentence.wav" },
    { "do": "holdUntilAudioEnd" },
    { "do": "wait", "ms": 200 },
    { "do": "release" },
    { "do": "waitIdle", "timeoutMs": 300000 }
  ],
  "expect": {
    "deliveries": [
      { "to": "textbox", "text": "今日の会議の資料をチャットで送ります。", "minSimilarity": 0.8 }
    ],
    "textbox": { "text": "今日の会議の資料をチャットで送ります。", "minSimilarity": 0.8 },
    "states": ["モデル準備中", "録音中", "処理中", "貼り付け完了"],
    "stateTexts": ["完了まで音声入力は使えません"],
    "forbiddenStates": ["退避"],
    "cancellations": ["ModelNotReady"],
    "shots": [{ "name": "離した後", "state": "モデル準備中" }],
    "runtime": "Vulkan",
    "maxReleaseToDeliverMs": 3000,
    "warnings": [],
    "holdSkips": ["モデル準備中のため録音していない"],
    "screenshots": ["モデル準備中", "貼り付け完了"],
    "versionFile": "VERSION"
  }
}
