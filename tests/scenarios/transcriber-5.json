{
  "name": "transcriber-5",
  "persona": "transcriber",
  "step": 5,
  "description": "順序: 2 本を間を空けずに連投する(1 本目を離した直後に 2 本目を押す)。流した順で届き、入れ替わらない",
  "timeoutMs": 600000,
  "actions": [
    { "do": "waitModel", "timeoutMs": 540000 },
    { "do": "focus", "window": "textbox" },
    { "do": "press", "audio": "tests/fixtures/audio/utt-07.wav" },
    { "do": "holdUntilAudioEnd" },
    { "do": "release" },
    { "do": "press", "audio": "tests/fixtures/audio/utt-08.wav" },
    { "do": "holdUntilAudioEnd" },
    { "do": "release" },
    { "do": "waitIdle", "timeoutMs": 300000 }
  ],
  "expect": {
    "deliveries": [
      { "to": "textbox", "text": "画面の配置について意見をください。", "minSimilarity": 0.8 },
      { "to": "textbox", "text": "明日の打ち合わせは会議室でやります。", "minSimilarity": 0.8 }
    ],
    "textbox": { "text": "画面の配置について意見をください。明日の打ち合わせは会議室でやります。", "minSimilarity": 0.8 },
    "forbiddenStates": ["退避", "取り消し", "取り消し(無音)"],
    "cancellations": [],
    "maxReleaseToDeliverMs": 1000
  }
}
